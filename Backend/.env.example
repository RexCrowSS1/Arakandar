BANDAR_PASAR_DEBUG=false
BANDAR_PASAR_AI_ENABLED=true
BANDAR_PASAR_AI_MODEL_ID=Timothyemmanuel/Arakandar
BANDAR_PASAR_AI_MODEL_REVISION=1b7b0adc10b5da17f94e0f14af08399d0e67744d
# auto selects CUDA, Apple Silicon MPS, then CPU.
BANDAR_PASAR_AI_DEVICE=auto
BANDAR_PASAR_AI_MAX_NEW_TOKENS=256
BANDAR_PASAR_AI_CONTEXT_TOKENS=4096
# Search runs on the backend and grounds the local model with public sources.
# google_news: news headlines (default); bing: general web RSS;
# duckduckgo, brave, google: general web through DDGS (may be rate limited).
BANDAR_PASAR_WEB_ENABLED=true
BANDAR_PASAR_WEB_BACKEND=google_news
BANDAR_PASAR_WEB_TIMEOUT_SECONDS=8
BANDAR_PASAR_WEB_MAX_RESULTS=3
# Public delayed quotes. Independent of local AI inference.
BANDAR_PASAR_MARKET_REFRESH_SECONDS=60
BANDAR_PASAR_MARKET_TIMEOUT_SECONDS=8
BANDAR_PASAR_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# Supabase server credentials. Keep the secret key private and never commit .env.
SUPABASE_URL=https://otryvndpjxkgsjglaaeo.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
SUPABASE_SECRET_KEY=replace-with-your-secret-key
SUPABASE_JWKS_URL=https://otryvndpjxkgsjglaaeo.supabase.co/auth/v1/.well-known/jwks.json
